# ── Secrets (절대 커밋 금지) ─────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
# 개인 금융 실데이터(뱅크샐러드 내보내기 등) — 위치 불문 커밋 금지
*.xlsx

# ── Data / runtime (디렉터리는 유지, 내용물만 무시) ──────
data/*
!data/.gitkeep
!data/cache
data/cache/*
!data/cache/.gitkeep
logs/*
!logs/.gitkeep
*.log

# ── Hermes runtime state ────────────────────────────────
.hermes/

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# ── Node ────────────────────────────────────────────────
node_modules/

# ── OS / editor ─────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
