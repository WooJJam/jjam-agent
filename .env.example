# ─────────────────────────────────────────────────────────────
# jjam-agent 환경변수 예시 — 실제 값은 .env 에만 넣고 커밋 금지
# 복사: cp .env.example .env  (Windows PowerShell: Copy-Item .env.example .env)
# ─────────────────────────────────────────────────────────────

# Discord
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
DISCORD_ALLOWED_CHANNEL_ID=

# OpenAI (기본 모델: GPT-5.6 Luna)
OPENAI_API_KEY=
DEFAULT_MODEL=gpt-5.6-luna

# 뉴스 브리핑
# Brave Search API (RSS 없는 소스 수집용: Anthropic/Meta/Reuters 등). 미설정 시 RSS 소스만 수집.
BRAVE_API_KEY=
# 브리핑 자동 전송용 Discord Webhook URL (make-briefing.py). 미설정 시 콘솔 출력.
DISCORD_WEBHOOK_URL=

# 날씨 (WEATHER_LOCATION 미설정 시 기본값 '서울')
WEATHER_API_KEY=
WEATHER_LOCATION=서울

# AWS (EC2에서는 Access Key 대신 읽기전용 IAM Role 사용 권장)
AWS_REGION=ap-northeast-2

# 시간대
TZ=Asia/Seoul
